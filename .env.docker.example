# Copy to config/.env. Replace secrets and use the server address users visit.
POSTGRES_PASSWORD=
ANALYTICS_PEPPER=
ANALYTICS_ORIGIN=http://analytics.internal:4319
ALLOW_HTTP=true
BIND_ADDRESS=0.0.0.0
APP_PORT=4319
IMAGE_NAME=piora-analytics
APP_VERSION=latest
INIT_ORG_NAME=Piora
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# compose.yaml mounts this host directory read-only at /config.
# Store this file as <CONFIG_DIR>/.env and pass the same file with --env-file.
CONFIG_DIR=./config

# Required: host directories for PostgreSQL and shared exports.
# Set absolute paths on the intended data disk and create directories first.
POSTGRES_DATA_DIR=
EXPORT_DATA_DIR=
