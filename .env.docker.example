# 唯一部署配置：复制到 <配置目录>/.env，详细说明见 docs/deployment.md。
# 启动：bash scripts/start.sh image /data/piora/config

# 宿主机目录：必须预先创建，建议使用实际数据盘上的绝对路径，三个目录不要重叠。
# 配置目录仅通过启动脚本第二个参数或宿主机 CONFIG_DIR 环境变量指定。
# 必填：PostgreSQL 数据目录，读写挂载到 /var/lib/postgresql。
POSTGRES_DATA_DIR=
# 必填：API/Worker 共享导出目录，读写挂载到 /exports。
EXPORT_DATA_DIR=

# 必填：URL 安全的随机数据库密码，推荐 openssl rand -hex 32。
# 初始化后仅改此值不会修改数据库中的密码。
POSTGRES_PASSWORD=
# 必填：至少 32 字符随机秘密，单独生成，升级时保持不变。
ANALYTICS_PEPPER=

# 改为浏览器实际访问地址（协议、地址、端口），末尾不要带斜线。
ANALYTICS_ORIGIN=http://analytics.internal:4319
# 受信任内网 HTTP 用 true；HTTPS 用 false。
ALLOW_HTTP=true
# 0.0.0.0 允许内网访问；127.0.0.1 仅本机。Compose 缺省为 127.0.0.1。
BIND_ADDRESS=0.0.0.0
# 宿主机端口，修改时同步调整 ANALYTICS_ORIGIN。
APP_PORT=4319

# 源码构建保留 piora-analytics；发布镜像改为 ghcr.io/kexijiang/piora-analytics。
IMAGE_NAME=piora-analytics
# 镜像标签，正式部署推荐指定已发布版本；离线时必须与本机镜像一致。
APP_VERSION=latest

# 以下仅用于首次空库初始化，修改不会覆盖已有组织或账号。
INIT_ORG_NAME=Piora
INIT_ADMIN_USERNAME=admin
# 首次必填：12–256 字符，首次登录强制修改；初始化完成后可移除。
INIT_ADMIN_PASSWORD=
